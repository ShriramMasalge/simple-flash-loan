# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# Environment variables (never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Contract artifacts (compiled by `npm run compile`)
contracts/managed/

# Deployment info
deployment.json

# Wallet seeds / mnemonics / state (sensitive — never commit)
*.seed
*.mnemonic
.midnight-state.json
.midnight-wallet-state/

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.pid.lock

# Coverage directory
coverage/

# Private state
*-state/
midnight-level-db/

# Temporary files
tmp/
temp/

# Development scripts
scripts/

# Frontend build output
frontend/dist/

# Generated contract module synced into the frontend source tree by `npm run sync:zk`
frontend/src/zk-contract/
